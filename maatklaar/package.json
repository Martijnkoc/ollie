{
  "name": "maatklaar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "vendor": "node scripts/copy-vendor-assets.mjs",
    "predev": "node scripts/copy-vendor-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vendor-assets.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"e2e/**/*.{ts,mjs}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"e2e/**/*.{ts,mjs}\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tesseract.js-data/nld": "1.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
