# MaatKlaar — only variable names and safe defaults. Never commit real values.
# Copy to .env.local for local development.

# --- Basis ---------------------------------------------------------------
# Public address of this deployment; used for the payment return URL and the Mollie webhook URL.
APP_URL=http://localhost:3000

# --- Betalen (Mollie Payments API v2) -------------------------------------
# test_… for test mode, live_… for real payments. Without a key:
#   development → labelled DEMO mode (no money moves), production → payments disabled.
MOLLIE_API_KEY=
# Only change for tests against a Mollie test double.
# MOLLIE_API_URL=https://api.mollie.com/v2
# Protected previews only: allow the labelled DEMO checkout in a production build.
# ALLOW_DEMO_PAYMENTS=true

# --- Ordermetadata en overdrachten ----------------------------------------
# Postgres for orders (order id, project reference, amount, status) and for short-lived, encrypted transfers
# between phone and computer. Required in production with Mollie and for "Scannen met je telefoon".
# Locally empty: a JSON file in .data/orders.json is used.
DATABASE_URL=
# ORDERS_FILE=.data/orders.json
# Only for a single-server setup with persistent disk:
# ALLOW_FILE_ORDER_STORE=true
# ALLOW_FILE_TRANSFER_STORE=true
# TRANSFERS_FILE=.data/transfers.json

# --- PDOK (adres en BAG) --------------------------------------------------
# Defaults are the official endpoints; override only for tests.
# PDOK_LOCATIESERVER_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1
# PDOK_BAG_URL=https://api.pdok.nl/kadaster/bag/ogc/v2
# PDOK_TIMEOUT_MS=6000
