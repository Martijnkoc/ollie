# Voetbalradar — environment variables.
# Only names and safe defaults live here. Never commit real values.
# [server] = only read on the server, never sent to the browser.
# [public] = NEXT_PUBLIC_*, ends up in the browser bundle; never put a secret in one.

# --- Site ------------------------------------------------------------------
# [server] Public address of this deployment, without trailing slash. Used for canonical URLs,
# Open Graph, robots.txt and the sitemap. Required in production.
SITE_URL=http://localhost:3000

# --- Database (Postgres) ---------------------------------------------------
# [server] Leave empty locally: an embedded Postgres (PGlite) is stored in .data/.
# Production: a dedicated Postgres for Voetbalradar, e.g. a Supabase project
# (transaction pooler URL, port 6543). Never point this at another app's database.
DATABASE_URL=
# [server] Connections per server instance.
DATABASE_POOL_SIZE=5
# [server] Only for local/e2e use of the embedded database in a production build.
# PGLITE_DIR=.data/pglite

# --- Football data -----------------------------------------------------------
# [server] sportmonks | demo | none. Empty + SPORTMONKS_API_TOKEN set means sportmonks.
DATA_PROVIDER=
# [server] Sportmonks API token. Sent only from the server, in a header.
SPORTMONKS_API_TOKEN=
# [server] Comma-separated competition slugs to synchronise; empty = whole catalogue.
# eredivisie,champions-league,europa-league,premier-league,la-liga,serie-a,bundesliga,ligue-1,superliga,scottish-premiership
COMPETITIONS=
# [server] Seconds between live refreshes while matches are being played (10–600).
LIVE_POLL_SECONDS=30
# [server] Optional cap on provider requests per day. Non-live jobs stop at 80 % of it.
PROVIDER_DAILY_BUDGET=
# [server] Demo data in a production build (protected preview only). Never on a public site.
# ALLOW_DEMO_DATA=true

# --- Scheduling and administration ----------------------------------------
# [server] Bearer secret for /api/cron/sync (Vercel Cron sends it automatically). Min. 24 chars.
CRON_SECRET=
# [server] HTTP Basic credentials for /beheer and /api/admin/sync. Password min. 16 chars.
# Without both, the admin area is closed.
ADMIN_USER=
ADMIN_PASSWORD=
# [server] Let visitor traffic trigger the live job when it is due (lease + budget still apply).
# Useful when no scheduler can run every minute. Off by default.
SYNC_ON_TRAFFIC=false

# --- AI analyses -------------------------------------------------------------
# [server] Anthropic API key. Without it, no analyses are generated and the site says so.
ANTHROPIC_API_KEY=
# [server] Model id. Default claude-opus-5-5; claude-haiku-5-5 is far cheaper (see docs/kosten.md).
AI_MODEL=claude-opus-5-5
# [server] low | medium | high.
AI_EFFORT=low
# [server] Maximum generation attempts per day (0 disables AI).
AI_DAILY_LIMIT=100

# --- Presentation --------------------------------------------------------------
# [server] Show club logos from the provider's CDN. Only after the licence check in
# docs/rechten-checklist.md; otherwise neutral initials are shown.
SHOW_PROVIDER_LOGOS=false
# [public] Reserve advertising positions. Requires a consent setup first; no scripts are loaded.
NEXT_PUBLIC_ADS_ENABLED=false
