# Only variable names and safe defaults live here. Never commit real values.

# --- Basis ---------------------------------------------------------------
# Public address of this deployment (links in e-mails).
APP_URL=http://localhost:3000
# Long random string; used for login-code hashing.
SESSION_SECRET=

# --- Database (Postgres) -------------------------------------------------
# Leave empty locally: an embedded Postgres (PGlite) is stored in .data/.
# Production: a separate Postgres for Cafe, e.g. a Supabase project (pooler URL, port 6543).
DATABASE_URL=
DATABASE_POOL_SIZE=5

# --- Inloggen (e-mailcode) -----------------------------------------------
# Option A, managed: Supabase Auth sends and checks the code.
#   The Supabase e-mail template must contain {{ .Token }} so people receive a 6-digit code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Option B: we send the code ourselves through Resend (also used for all other e-mail).
RESEND_API_KEY=
MAIL_FROM="Cafe <hallo@example.nl>"

# --- Betalen (Stripe, begin in testmodus: sk_test_…) ----------------------
STRIPE_SECRET_KEY=
# The recurring price of the membership (price_…).
STRIPE_PRICE_ID=
# Signing secret of the webhook endpoint /api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Shown in the interface; the real amount is the Stripe price.
MEMBERSHIP_PRICE_LABEL=€4,99
MEMBERSHIP_DATES_PER_PERIOD=5
MEMBERSHIP_PRICE_NOTE=

# --- Video (Daily) -------------------------------------------------------
DAILY_API_KEY=

# --- Onderhoud -----------------------------------------------------------
# Vercel Cron sends this as a Bearer token to /api/cron/sweep.
CRON_SECRET=

# --- Alleen voor geautomatiseerde tests en een afgeschermde preview ------
# Never in production: mail into a database table and a labelled fake video provider.
# ALLOW_TEST_TRANSPORTS=true
# MAIL_TRANSPORT=outbox
# VIDEO_PROVIDER=fake
