# Database. Leave empty for local development: an embedded Postgres (PGlite) is
# stored in .data/. In production use Postgres, e.g. Supabase (pooler, port 6543).
DATABASE_URL=

# Public address, used in e-mails and share links.
APP_URL=http://localhost:3000

# Video (Daily.co). Without a key the room runs in demo mode (own camera only).
DAILY_API_KEY=

# E-mail (Resend). Without a key, mails are written to the server log.
RESEND_API_KEY=
MAIL_FROM="Ollie <hallo@example.nl>"

# Organiser dashboard at /admin.
ADMIN_PASSWORD=
SESSION_SECRET=

# Community launch region(s), comma-separated keys from src/lib/config.ts.
LAUNCH_REGIONS=utrecht

# Free invitations per host e-mail per 30 days during the trial.
MONTHLY_DATE_LIMIT=5

# Set to true once Cafe opens.
CAFE_OPEN=false
