# Only variable names and safe defaults live here. Never commit real values.

# --- Basis ---------------------------------------------------------------
# Public address of this deployment (links in e-mails, Stripe return URLs).
APP_URL=http://localhost:3000
# Long random string; used for login-code hashing.
SESSION_SECRET=
# Shown on /contact.
CONTACT_EMAIL=

# --- Database (Postgres) -------------------------------------------------
# Leave empty locally: an embedded Postgres (PGlite) is stored in .data/.
# Production: a Supabase project for Sell Yourself (transaction pooler URL, port 6543).
DATABASE_URL=
DATABASE_POOL_SIZE=5

# --- Inloggen (e-mailcode) -----------------------------------------------
# Option A, managed: Supabase Auth sends and checks the code.
#   The Supabase e-mail template must contain {{ .Token }} so people receive a 6-digit code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Option B: we send the code ourselves through Resend (also used for all other e-mail).
RESEND_API_KEY=
MAIL_FROM="Sell Yourself <hallo@example.nl>"

# --- Opslag (foto's en video's) ------------------------------------------
# Supabase Storage. The service role key stays on the server; browsers get short-lived signed upload URLs.
# Create a PUBLIC bucket with this name (see README for size and type limits).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Betalen (Stripe Connect, begin in testmodus: sk_test_…) ---------------
STRIPE_SECRET_KEY=
# Signing secret of the platform webhook endpoint /api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect ("connected accounts") webhook endpoint, same URL (whsec_…).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Platform fee in percent of the agreed price, paid by the maker. A configuration value, not a validated model.
PLATFORM_FEE_PERCENT=10

# --- Onderhoud -----------------------------------------------------------
# Vercel Cron sends this as a Bearer token to /api/cron/sweep.
CRON_SECRET=

# --- Alleen voor geautomatiseerde tests en een afgeschermde preview ------
# Never in production: mail into a database table and files on the server's own disk.
# ALLOW_TEST_TRANSPORTS=true
# MAIL_TRANSPORT=outbox
# STORAGE_PROVIDER=local
# UPLOAD_DIR=.data/uploads
